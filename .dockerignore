# Allowlist the API and selected private worker sources. Never upload .env files,
# native signing material, player saves, or the repository's Git history.
**
!Dockerfile.api
!.dockerignore
!supabase/
supabase/**
!supabase/functions/
!supabase/functions/**
supabase/functions/**/*.test.ts
!scripts/
scripts/**
!scripts/operations.mjs
!scripts/run-operations.mjs
!scripts/private-settings.mjs
!scripts/privacy-discovery.mjs
!scripts/dispute-recovery.mjs
**/.env*
**/.git/**
**/.openai/**
**/*.p12
**/*.p8
**/*.jks
**/*.keystore
