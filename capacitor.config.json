{
  "appId": "com.speedinno.brickbreaker",
  "appName": "Brick Breaker",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#14171c",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#14171c",
    "contentInset": "never",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SystemBars": {
      "hidden": false,
      "style": "DARK",
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  },
  "includePlugins": [
    "@capacitor/app",
    "@capacitor/haptics",
    "@revenuecat/purchases-capacitor"
  ]
}
