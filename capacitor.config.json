{
  "appId": "com.speedinno.brickbreaker",
  "appName": "Brick Breaker",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#14171c",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#14171c",
    "contentInset": "never",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "style": "DARK",
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
