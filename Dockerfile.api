FROM denoland/deno:2.9.6
WORKDIR /app
COPY supabase/functions/ ./supabase/functions/
COPY scripts/operations.mjs scripts/run-operations.mjs scripts/private-settings.mjs scripts/privacy-discovery.mjs scripts/dispute-recovery.mjs ./scripts/
RUN deno cache --frozen --config supabase/functions/deno.json supabase/functions/game-api/index.ts scripts/run-operations.mjs
ENV PORT=8000
EXPOSE 8000
USER deno
CMD ["run", "--cached-only", "--frozen", "--allow-env", "--allow-net", "--config", "supabase/functions/deno.json", "supabase/functions/game-api/index.ts"]
