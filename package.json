{
  "name": "brick-breaker",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Dense channel-and-swarm brick breaker for web, Android, and iPhone",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build:web": "node scripts/build-web.mjs",
    "configure:cloud": "node scripts/configure-cloud.mjs",
    "configure:ads": "node scripts/configure-ads.mjs",
    "recover:disputes": "node scripts/reconcile-web-disputes.mjs",
    "recover:privacy": "node scripts/reconcile-privacy.mjs",
    "mobile:sync": "node scripts/sync-mobile.mjs",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@revenuecat/purchases-capacitor": "13.7.6",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@electric-sql/pglite": "0.5.10",
    "esbuild": "0.28.2"
  }
}
