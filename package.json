{
  "name": "brick-breaker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Dense channel-and-swarm brick breaker for web, Android, and iPhone",
  "scripts": {
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check dist/engine.js && node --check dist/app.js && node --check dist/sw.js",
    "mobile:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3"
  }
}
