# Copy to .env.api (Git ignores it). These are SERVER deployment settings.
# This file is never included in the container build context or mobile app.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY
# Alternatively use SUPABASE_SECRET_KEY for the newer Supabase server secret.
# Supply one real server key; do not leave the placeholder above populated.
# Native mobile origins; add browser origins only if needed for testing.
ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# Keep sandbox in a separate Supabase/provider project. Optional collection
# stays off until migrations, privacy review and a live retention worker pass.
MONETIZATION_ENVIRONMENT=production
PLAY_METRICS_ENABLED=false
# Optional provider values, after the ordered account setup. All values below
# remain server-side; use complete one-line JSON from the provider setup guide.
# REVENUECAT_CONFIG_JSON=YOUR_PRIVATE_NATIVE_MAPPING_JSON
# REVENUECAT_SECRET_KEY=YOUR_REVENUECAT_V2_SERVER_KEY
# REVENUECAT_WEBHOOK_AUTH=YOUR_RANDOM_32_OR_MORE_CHARACTER_WEBHOOK_SECRET
# RAZORPAY_CONFIG_JSON=YOUR_PRIVATE_MERCHANT_MAPPING_JSON
# RAZORPAY_KEY_ID=YOUR_MATCHING_RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# RAZORPAY_WEBHOOK_SECRETS_JSON=YOUR_PRIVATE_WEBHOOK_KEYRING_JSON
# REWARDED_ADS_CONFIG_JSON=YOUR_PRIVATE_PLACEMENT_MAPPING_JSON
# Worker-only deletion/discovery keyring, including still-needed retired projects:
# PRIVACY_REVENUECAT_KEYS_JSON=YOUR_PRIVATE_REVENUECAT_CLEANUP_KEYRING_JSON
# Optional one-time Auth/Resend configuration (never mobile settings).
# SUPABASE_ACCESS_TOKEN=YOUR_ACCOUNT_MANAGEMENT_TOKEN
# RESEND_API_KEY=YOUR_RESEND_API_KEY
# AUTH_SENDER_EMAIL=login@YOUR_VERIFIED_DOMAIN
# SUPPORT_EMAIL=support@YOUR_DOMAIN
# TEST_EMAIL=YOUR_OWNED_TEST_INBOX
